# rcmain: 9pm version
if(~ $#home 0) home=/
# HOME n'existe pas dans une session Windows ordinaire (sshd seul le définit) :
# $home, exporté, devient HOME pour les programmes lancés (ssh y lit ~/.ssh)
if(! ~ $#HOME 0) home=$HOME
if not if(! ~ $#USERPROFILE 0) home=$USERPROFILE
if(~ $#ifs 0) ifs=' 	
'
switch($#prompt){
case 0
case 1
	prompt=('% ' '	')
}
if(~ $rcname v.out) prompt=('broken! ' '	')
if(! ~ $#cflag 0){
	if(flag l && /bin/test -r $home/lib/profile) . $home/lib/profile
	status=''
	if(! ~ $#rcsh0 0) 0=$rcsh0
	eval $cflag
}
if not if(flag i){
	if(flag l && /bin/test -r $home/lib/profile) . $home/lib/profile
	status=''
	if(! ~ $#* 0) . $*
	if not . -i 'stdin$'
}
if not {
	if(~ $#* 0) . 'stdin$'
	if not{
		status=''
		. $*
	}
}
exit $status
